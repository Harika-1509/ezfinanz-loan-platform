# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ezfinanz?schema=public"

# Authentication & Security
JWT_SECRET=ezfinanz_development_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"
