# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL with Prisma)
# Example: postgresql://username:password@localhost:5432/ezfinanz?schema=public
# Or Neon / Supabase / Cloud Postgres connection string
DATABASE_URL="postgresql://username:password@localhost:5432/ezfinanz?schema=public"

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"
API_PREFIX="/api/v1"
