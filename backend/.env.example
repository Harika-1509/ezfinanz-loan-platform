# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL with Prisma & PgBouncer)
DATABASE_URL="postgresql://username:password@localhost:5432/ezfinanz?schema=public&pgbouncer=true&connection_limit=10&pool_timeout=30"

# Authentication & JWT Security
JWT_SECRET=ezfinanz_development_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS & Frontend URLs
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Google OAuth 2.0 (Optional for local testing / development)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# File Upload Storage Directory
UPLOAD_DIR=uploads

# ==============================================================================
# PRODUCTION OTP PROVIDERS (SMS + EMAIL)
# ==============================================================================

# Twilio Verify / SMS Provider
# Get these from Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_PHONE_NUMBER=+15551234567

# Email Provider Configuration
# Supported options: 'auto' | 'resend' | 'smtp'
EMAIL_PROVIDER=auto

# Option A: Resend (Recommended, https://resend.com)
RESEND_API_KEY=re_123456789abcdef

# Option B: SMTP (SendGrid, AWS SES, Brevo, Postmark, Gmail, Custom SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_smtp_password_or_api_key_here
EMAIL_FROM="EZFinanz Loans <support@ezfinanz.com>"

# OTP Security & Rate Limiting Controls
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_HMAC_SECRET=your_cryptographic_otp_salt_secret_here

