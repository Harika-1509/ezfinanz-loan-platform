// Prisma Schema for EZFinanz Personal Loan Application Platform
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  CUSTOMER
  ADMIN
}

enum ApplicationStage {
  SIGNUP_COMPLETED
  VERIFICATION_PENDING
  VERIFIED
  KYC_PENDING
  KYC_SUBMITTED
  ELIGIBILITY_CHECKED
  EMI_SELECTED
  BANK_ADDED
  DECLARATION_CONFIRMED
  SELFIE_PENDING
  WAITING_ADMIN_REVIEW
  APPROVED
  REJECTED
  DISBURSED
}

enum IdType {
  PAN
  AADHAAR
  PASSPORT
  VOTER_ID
}

enum EligibilityResult {
  ELIGIBLE
  PARTIALLY_ELIGIBLE
  NOT_ELIGIBLE
}

enum AdminReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==========================================
// MODELS
// ==========================================

model User {
  id              String         @id @default(uuid())
  email           String?        @unique
  phone           String?        @unique
  passwordHash    String?        @map("password_hash")
  oauthProvider   String?        @map("oauth_provider")
  oauthId         String?        @map("oauth_id")
  role            Role           @default(CUSTOMER)
  emailVerified   Boolean        @default(false) @map("email_verified")
  phoneVerified   Boolean        @default(false) @map("phone_verified")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relations
  applications     Application[]
  reviewedSelfies  Selfie[]       @relation("AdminReviewedSelfies")
  refreshTokens    RefreshToken[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Application {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage     ApplicationStage @default(SIGNUP_COMPLETED)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  // One-to-one relations for each application step
  kycDetails       KycDetails?
  eligibilityCheck EligibilityCheck?
  loanTerms        LoanTerms?
  bankAccount      BankAccount?
  declaration      Declaration?
  selfie           Selfie?

  @@index([userId])
  @@index([stage])
  @@map("applications")
}

model KycDetails {
  id            String      @id @default(uuid())
  applicationId String      @unique @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fullName      String      @map("full_name")
  dob           DateTime    @map("dob")
  gender        String      @map("gender")
  address       String      @map("address")
  idType        IdType      @map("id_type")
  idNumber      String      @map("id_number")
  idPhotoUrl    String?     @map("id_photo_url")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("kyc_details")
}

model EligibilityCheck {
  id                String            @id @default(uuid())
  applicationId     String            @unique @map("application_id")
  application       Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  income            Decimal           @db.Decimal(12, 2)
  requestedAmount   Decimal           @map("requested_amount") @db.Decimal(12, 2)
  creditScore       Int               @map("credit_score")
  existingDebts     Decimal           @map("existing_debts") @db.Decimal(12, 2)
  employerName      String            @map("employer_name")
  designation       String            @map("designation")
  dtiRatio          Decimal           @map("dti_ratio") @db.Decimal(5, 2)
  result            EligibilityResult
  maxApprovedAmount Decimal?          @map("max_approved_amount") @db.Decimal(12, 2)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@map("eligibility_checks")
}

model LoanTerms {
  id             String      @id @default(uuid())
  applicationId  String      @unique @map("application_id")
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  amount         Decimal     @db.Decimal(12, 2)
  tenureMonths   Int         @map("tenure_months")
  interestRate   Decimal     @map("interest_rate") @db.Decimal(5, 2)
  processingFee  Decimal     @map("processing_fee") @db.Decimal(12, 2)
  gst            Decimal     @map("gst") @db.Decimal(12, 2)
  otherCharges   Decimal     @map("other_charges") @db.Decimal(12, 2)
  emi            Decimal     @map("emi") @db.Decimal(12, 2)
  totalInterest  Decimal     @map("total_interest") @db.Decimal(12, 2)
  totalRepayment Decimal     @map("total_repayment") @db.Decimal(12, 2)
  totalCharges   Decimal     @map("total_charges") @db.Decimal(12, 2)
  netDisbursement Decimal    @map("net_disbursement") @db.Decimal(12, 2)
  irr            Decimal     @map("irr") @db.Decimal(5, 2)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@map("loan_terms")
}

model BankAccount {
  id            String      @id @default(uuid())
  applicationId String      @unique @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  holderName    String      @map("holder_name")
  accountNumber String      @map("account_number")
  ifsc          String      @map("ifsc")
  bankName      String      @map("bank_name")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("bank_accounts")
}

model Declaration {
  id            String      @id @default(uuid())
  applicationId String      @unique @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  acceptedAt    DateTime    @default(now()) @map("accepted_at")
  termsVersion  String      @default("v1.0") @map("terms_version")
  ipAddress     String?     @map("ip_address")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("declarations")
}

model Selfie {
  id            String            @id @default(uuid())
  applicationId String            @unique @map("application_id")
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  photoUrl      String            @map("photo_url")
  submittedAt   DateTime          @default(now()) @map("submitted_at")
  adminStatus   AdminReviewStatus @default(PENDING) @map("admin_status")
  rejectReason  String?           @map("reject_reason")
  reviewedBy    String?           @map("reviewed_by")
  reviewer      User?             @relation("AdminReviewedSelfies", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?         @map("reviewed_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([adminStatus])
  @@map("selfies")
}
