{
  "watch": ["src"],
  "ext": "ts,json",
  "ignore": [
    "src/**/*.test.ts",
    "src/**/__tests__/**",
    "node_modules",
    "dist",
    "uploads",
    "prisma/migrations",
    ".git",
    "../frontend"
  ],
  "exec": "tsx src/server.ts",
  "delay": 500,
  "env": {
    "NODE_ENV": "development"
  }
}
